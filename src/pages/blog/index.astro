---
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map(p => p.data.category))];
---

<Base
  title="Blog — artykuły o copywritingu"
  description="Artykuły o copywritingu, SEO, budowaniu portfolio, zdobywaniu klientów i zarabianiu na pisaniu tekstów. Praktyczne poradniki dla copywriterów."
>
  <Breadcrumbs items={[{ label: 'Blog' }]} />

  <div class="container">
    <header class="page-header" style="border: none;">
      <h1>Blog</h1>
      <p>Artykuły o copywritingu, które pomogą Ci rozwinąć karierę i zarabiać więcej na pisaniu.</p>
    </header>

    <div class="posts-grid">
      {posts.map(post => (
        <PostCard
          title={post.data.title}
          slug={post.id.replace(/\.md$/, '')}
          description={post.data.description}
          pubDate={post.data.pubDate}
          category={post.data.category}
          readingTime={post.data.readingTime}
        />
      ))}
    </div>
  </div>
</Base>
