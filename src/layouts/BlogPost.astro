---
import Base from './Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category?: string;
  readingTime?: number;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, category = 'Copywriting', readingTime, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updatedDate?.toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = 'https://www.zostancopywriterem.pl';
const articleUrl = `${siteUrl}${Astro.url.pathname}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  ...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
  "author": {
    "@type": "Organization",
    "name": "Zostań Copywriterem",
    "url": siteUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": "Zostań Copywriterem",
    "url": siteUrl,
  },
  "mainEntityOfPage": articleUrl,
  "inLanguage": "pl-PL",
  "keywords": tags.join(', '),
};
---

<Base
  title={title}
  description={description}
  ogType="article"
  articleDate={pubDate}
  articleModified={updatedDate}
>
  <Breadcrumbs items={[
    { label: 'Blog', href: '/blog' },
    { label: title },
  ]} />

  <article class="container" itemscope itemtype="https://schema.org/Article">
    <header class="article-header">
      <span class="post-card-category">{category}</span>
      <h1 itemprop="headline">{title}</h1>
      <div class="article-meta">
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <time datetime={pubDate.toISOString()} itemprop="datePublished">{formattedDate}</time>
        </span>
        {readingTime && (
          <span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {readingTime} min czytania
          </span>
        )}
        {formattedUpdated && (
          <span>
            Zaktualizowano: <time datetime={updatedDate!.toISOString()} itemprop="dateModified">{formattedUpdated}</time>
          </span>
        )}
      </div>
    </header>

    <div class="prose" itemprop="articleBody">
      <slot />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</Base>
